---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const docs = await getCollection("components");
---

<Layout
  title="Documentation | ForgeXUI"
  description="Documentation and usage guides for ForgeXUI components."
>
  <main class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <!-- Hero -->
    <header class="max-w-2xl">
      <p class="text-sm font-medium text-zinc-500">
        Documentation
      </p>

      <h1
        class="mt-3 text-4xl font-semibold tracking-tight text-zinc-100 sm:text-5xl"
      >
        Build better interfaces.
      </h1>

      <p class="mt-4 max-w-xl text-base leading-7 text-zinc-500 sm:text-lg sm:leading-8">
        Explore ForgeXUI components, learn how they work, and copy them directly into your project.
      </p>
    </header>

    <!-- Components -->
    <section class="mt-20 sm:mt-24">
      <div class="mb-6">
        <p class="text-xs font-medium uppercase tracking-[0.16em] text-zinc-600">
          Components
        </p>

        <div class="mt-3  flex items-baseline justify-between gap-4">
          <h2 class="text-2xl  font-semibold tracking-tight text-zinc-100">
            Explore the library
          </h2>

          <span class="text-sm text-zinc-600">
            {docs.length} {docs.length === 1 ? "component" : "components"}
          </span>
        </div>
      </div>

      <div class="grid items-stretch mt-3 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          docs.map((doc) => (
            <a
              href={`/docs/${doc.id}`}
              class="group flex h-full flex-col rounded-2xl border border-white/10 bg-white/[0.02] p-6 transition-colors duration-200 hover:border-white/15 hover:bg-white/[0.04]"
            >
              <div class="flex items-start justify-between gap-4">
                <h3 class="text-base font-medium text-zinc-200">
                  {doc.data.title}
                </h3>

                <span
                  class="text-zinc-700 transition-all duration-200 group-hover:translate-x-1 group-hover:text-zinc-400"
                  aria-hidden="true"
                >
                  →
                </span>
              </div>

              <p class="mt-3 text-sm leading-6 text-zinc-500">
                {doc.data.description}
              </p>

              <span class="mt-auto block pt-6 text-sm text-zinc-600 transition-colors duration-200 group-hover:text-zinc-300">
                Read documentation
              </span>
            </a>
          ))
        }
      </div>
    </section>
  </main>
</Layout>
