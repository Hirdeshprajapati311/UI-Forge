---
import Layout from "../layouts/Layout.astro";
import { components } from "../lib/components";
---

<Layout
  title="UI Forge | Beautiful UI Components"
  description="Beautiful, reusable React components that you can copy, customize, and make your own."
>
  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden">
      <div class="mx-auto max-w-6xl px-6 pb-24 pt-24 sm:pb-32 sm:pt-32">

        <div class="mx-auto max-w-3xl text-center">

          <div class="inline-flex items-center rounded-full border border-white/10 bg-white/[0.03] px-4 py-2 text-sm text-zinc-400">
            Open source UI components
          </div>

          <h1 class="mt-8 text-5xl font-bold tracking-tight text-white sm:text-7xl">
            Beautiful UI.
            <span class="block text-zinc-500">
              Made easy.
            </span>
          </h1>

          <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-zinc-400">
            Copy, customize, and ship beautiful React components
            without rebuilding the same UI from scratch.
          </p>

          <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
            <a
              href="/components"
              class="rounded-xl bg-white px-6 py-3 text-sm font-semibold text-black transition-transform hover:scale-[1.02]"
            >
              Explore components
            </a>

            <a
              href="https://github.com"
              class="rounded-xl border border-white/10 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/[0.05]"
            >
              View on GitHub
            </a>
          </div>

        </div>
      </div>
    </section>

    <!-- Featured components -->
    <section class="border-t border-white/10">
      <div class="mx-auto max-w-7xl px-6 py-20">

        <div class="flex items-end justify-between gap-6">
          <div>
            <p class="text-sm font-medium uppercase tracking-widest text-zinc-500">
              Explore
            </p>

            <h2 class="mt-3 text-3xl font-bold tracking-tight text-white">
              Components
            </h2>

            <p class="mt-3 max-w-xl text-zinc-400">
              Small building blocks for interfaces that don't look
              like they came out of a template factory.
            </p>
          </div>

          <a
            href="/components"
            class="hidden text-sm font-medium text-zinc-400 hover:text-white sm:block"
          >
            View all →
          </a>
        </div>

        <div class="mt-10 grid gap-6 sm:grid-cols-2">

          {
            components.map((component) => (
              <a
                href={`/components/${component.slug}`}
                class="group rounded-2xl border border-white/10 bg-white/[0.02] p-6 transition-all hover:-translate-y-1 hover:border-white/20 hover:bg-white/[0.04]"
              >
                <div class="flex items-center justify-between">
                  <span class="text-xs font-medium uppercase tracking-wider text-zinc-500">
                    {component.category}
                  </span>

                  <span class="text-zinc-600 transition-transform group-hover:translate-x-1">
                    &rarr;
                  </span>
                </div>

                <h3 class="mt-8 text-xl font-semibold text-white">
                  {component.name}
                </h3>

                <p class="mt-3 text-sm leading-6 text-zinc-400">
                  {component.description}
                </p>
              </a>
            ))
          }

        </div>

      </div>
    </section>

    <!-- CTA -->
    <section class="border-t border-white/10">
      <div class="mx-auto max-w-4xl px-6 py-24 text-center">

        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Stop rebuilding the same interface.
        </h2>

        <p class="mx-auto mt-4 max-w-xl text-zinc-400">
          Browse the library, grab what you need, and get back to
          building the thing that actually matters.
        </p>

        <a
          href="/components"
          class="mt-8 inline-flex rounded-xl bg-white px-6 py-3 text-sm font-semibold text-black transition-transform hover:scale-[1.02]"
        >
          Browse components
        </a>

      </div>
    </section>
  </main>
</Layout>