---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ComponentPreview from "../../components/layout/ComponentPreview.astro";
import CodeCopyButtons from "../../components/docs/CodeCopyButtons.astro";
import MagneticButtonDemo from "../../components/demos/MagneticButtonDemo";
import SpotlightCardDemo from "../../components/demos/SpotlightCardDemo";
import GradientTextDemo from "../../components/demos/GradientTextDemo";
import FocusLensDemo from "../../components/demos/FocusLensDemo";
import MagneticTextTrailDemo from "../../components/demos/MagneticTextTrailDemo";
import PerspectiveStageDemo from "../../components/demos/PerspectiveStageDemo";
import { components } from "../../lib/components";

export async function getStaticPaths() {
  const docs = await getCollection("components");

  return components.map((component) => {
    const doc = docs.find((entry) => entry.id === component.slug);

    return {
      params: {
        slug: component.slug,
      },
      props: {
        component,
        doc,
      },
    };
  });
}

const { component, doc } = Astro.props;
const renderedDoc = doc ? await render(doc) : null;
const Content = renderedDoc?.Content;

const docsClass = "docs-content";
---

<Layout
  title={`${component.name} | UI Forge`}
  description={component.description}
>
  <section class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
    <a
      href="/components"
      class="text-sm text-zinc-500 transition-colors hover:text-zinc-300"
    >
      ← Back to components
    </a>

    <div class="mt-10">
      <p class="text-sm font-medium uppercase tracking-widest text-zinc-500">
        {component.category}
      </p>

      <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
        {component.name}
      </h1>

      <p class="mt-5 max-w-2xl text-lg leading-8 text-zinc-400">
        {component.description}
      </p>
    </div>

    <div class="mt-12">
      <ComponentPreview title="Preview">
        {component.slug === "magnetic-button" ? (
          <MagneticButtonDemo client:load />
        ) : component.slug === "spotlight-card" ? (
          <SpotlightCardDemo client:load />
        ) : component.slug === "gradient-text" ? (
          <GradientTextDemo client:load />
        ) : component.slug === "focus-lens" ? (
          <FocusLensDemo client:load />
        ) : component.slug === "magnetic-text-trail" ? (
          <MagneticTextTrailDemo client:load />
        ) : component.slug === "perspective-stage" ? (
          <PerspectiveStageDemo client:load />
        ) : (
          <p class="text-sm text-zinc-500">Preview unavailable.</p>
        )}
      </ComponentPreview>
    </div>

    <div
      class={`${docsClass} mt-12 rounded-3xl border border-white/10 bg-white/[0.02] p-6 sm:p-10`}
    >
      {Content ? <Content /> : <p>Documentation is unavailable.</p>}
    </div>
  </section>
</Layout>

<CodeCopyButtons />
