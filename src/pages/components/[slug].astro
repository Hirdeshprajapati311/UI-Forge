---
import Layout from "../../layouts/Layout.astro";
import ComponentPreview from "../../components/layout/ComponentPreview.astro";
import MagneticButtonDemo from "../../components/demos/MagneticButtonDemo";
import { components } from "../../lib/components";

export function getStaticPaths() {
  return components.map((component) => ({
    params: {
      slug: component.slug,
    },
    props: {
      component,
    },
  }));
}

const { component } = Astro.props;
---

<Layout
  title={`${component.name} | UI Forge`}
  description={component.description}
>
  <section class="mx-auto max-w-5xl px-6 py-16 sm:py-20">

    <a
      href="/components"
      class="text-sm text-zinc-500 transition-colors hover:text-zinc-300"
    >
      ← Back to components
    </a>

    <div class="mt-10">
      <p class="text-sm font-medium uppercase tracking-widest text-zinc-500">
        {component.category}
      </p>

      <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
        {component.name}
      </h1>

      <p class="mt-5 max-w-2xl text-lg leading-8 text-zinc-400">
        {component.description}
      </p>
    </div>

    <div class="mt-12">
      <ComponentPreview title="Preview">
        <MagneticButtonDemo client:load />
      </ComponentPreview>
    </div>

    <div class="mt-12 space-y-12">

      <section>
        <h2 class="text-2xl font-semibold">
          Installation
        </h2>

        <div class="mt-4 rounded-xl border border-white/10 bg-zinc-900 p-4">
          <code class="text-sm text-zinc-300">
            Coming soon
          </code>
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-semibold">
          Usage
        </h2>

        <div class="mt-4 rounded-xl border border-white/10 bg-zinc-900 p-4">
          <code class="text-sm text-zinc-300">
            Coming soon
          </code>
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-semibold">
          About
        </h2>

        <p class="mt-4 max-w-3xl leading-7 text-zinc-400">
          This component is designed to be copied into your project
          and customized to fit your own design system.
        </p>
      </section>

    </div>

  </section>
</Layout>