---
import { getCollection, render } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import CodeCopyButtons from "../../../components/docs/CodeCopyButtons.astro";
import Forge3DUIDemo from "../../../components/forge3d/demos/Forge3DUIDemo";
import { forge3DUIElements } from "../../../components/forge3d/ui-registry";

export async function getStaticPaths() {
  const docs = await getCollection("forge3dui");
  return forge3DUIElements.map((component) => ({
    params: { slug: component.slug },
    props: { component, doc: docs.find((entry) => entry.id === component.slug) },
  }));
}

const { component, doc } = Astro.props;
const renderedDoc = doc ? await render(doc) : null;
const Content = renderedDoc?.Content;
---

<Layout title={`${component.title} | ForgeX3D`} description={component.description}>
  <article class="forge3d-ui-detail">
    <a href="/3d/components" class="forge3d-library-back">← Back to 3D UI</a>
    <header class="forge3d-ui-detail-heading">
      <div>
        <p class="dimension-index">ForgeX3D / {component.category}</p>
        <h1>{component.title}</h1>
        <p>{component.description}</p>
      </div>
      <span>3D UI / {component.slug}</span>
    </header>
    <section class="forge3d-ui-detail-preview" aria-labelledby="forge3d-ui-preview-title">
      <div><h2 id="forge3d-ui-preview-title">Preview</h2><span>Interactive component</span></div>
      <Forge3DUIDemo client:load slug={component.slug} />
    </section>
    <div class="docs-content forge3d-ui-detail-docs">
      {Content ? <Content /> : <p>Documentation is unavailable.</p>}
    </div>
  </article>
</Layout>

<CodeCopyButtons />

<style is:global>
  .forge3d-ui-detail { max-width: 64rem; margin: 0 auto; padding: 5rem 1.5rem 8rem; }
  .forge3d-ui-detail-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-top: 4rem; }
  .forge3d-ui-detail-heading h1 { margin: 1rem 0; color: #e8fbff; font-size: clamp(3rem, 7vw, 6rem); font-weight: 500; letter-spacing: -.075em; line-height: .9; }
  .forge3d-ui-detail-heading > div > p:last-child { max-width: 32rem; color: #91b1bd; line-height: 1.7; }
  .forge3d-ui-detail-heading > span { color: #668993; font-size: .65rem; letter-spacing: .12em; text-transform: uppercase; }
  .forge3d-ui-detail-preview { margin-top: 5rem; padding: 1rem; border: 1px solid rgb(110 197 202 / .18); border-radius: 1.2rem; background: rgb(255 255 255 / .025); }
  .forge3d-ui-detail-preview > div:first-child { display: flex; align-items: center; justify-content: space-between; padding: .5rem .5rem 1rem; }
  .forge3d-ui-detail-preview h2 { color: #e8fbff; font-size: .8rem; font-weight: 600; } .forge3d-ui-detail-preview > div:first-child span { color: #668993; font-size: .65rem; letter-spacing: .1em; text-transform: uppercase; }
  .forge3d-ui-detail-docs { margin-top: 5rem; padding: 2rem; border: 1px solid rgb(255 255 255 / .1); border-radius: 1.2rem; background: rgb(255 255 255 / .025); }
  @media (min-width: 640px) { .forge3d-ui-detail-docs { padding: 3.5rem; } } @media (max-width: 700px) { .forge3d-ui-detail-heading { align-items: start; flex-direction: column; } .forge3d-ui-detail-heading > span { display: none; } }
</style>
