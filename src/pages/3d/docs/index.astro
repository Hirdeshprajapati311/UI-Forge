---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";

const modelDocs = await getCollection("forge3d");
const uiDocs = await getCollection("forge3dui");
const docs = [
  ...modelDocs.map((doc) => ({ doc, href: `/3d/models/${doc.id}`, group: "Models" })),
  ...uiDocs.map((doc) => ({ doc, href: `/3d/components/${doc.id}`, group: "3D UI" })),
];
---

<Layout
  title="Docs | ForgeX3D"
  description="Documentation for ForgeX3D models and 3D scene infrastructure."
>
  <section class="forge3d-docs-index">
    <header class="forge3d-docs-index-hero">
      <a href="/3d" class="forge3d-library-back">← Back to ForgeX3D</a>
      <p class="dimension-index">ForgeX3D / Docs</p>
      <h1>Build with<br /><em>dimension.</em></h1>
      <p>Implementation guides for ForgeX3D models, shared scene infrastructure, and the details that make depth feel intentional.</p>
    </header>

    <div class="forge3d-docs-list">
      {docs.map(({ doc, href, group }, index) => (
        <a href={href} class="forge3d-docs-card">
          <span>{String(index + 1).padStart(2, "0")}</span>
          <div>
            <h2>{doc.data.title}</h2>
            <p><b>{group}</b> · {doc.data.description}</p>
          </div>
          <b>↗</b>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style is:global>
  .forge3d-docs-index { min-height: 70vh; padding: 5rem max(1.5rem, calc((100vw - 76rem) / 2)) 8rem; background: radial-gradient(circle at 70% 15%, rgb(22 184 189 / .08), transparent 28rem); }
  .forge3d-docs-index-hero { max-width: 44rem; }
  .forge3d-docs-index-hero h1 { margin: 1.2rem 0; color: #e8fbff; font-size: clamp(3.2rem, 8vw, 7rem); font-weight: 500; letter-spacing: -.075em; line-height: .9; }
  .forge3d-docs-index-hero h1 em { color: #6ec5ca; font-style: normal; }
  .forge3d-docs-index-hero > p:last-child { max-width: 34rem; color: #91b1bd; line-height: 1.75; }
  .forge3d-docs-list { max-width: 58rem; margin-top: 6rem; border-top: 1px solid rgb(255 255 255 / .1); }
  .forge3d-docs-card { display: grid; grid-template-columns: 3rem 1fr auto; gap: 1.5rem; align-items: center; padding: 1.5rem 0; border-bottom: 1px solid rgb(255 255 255 / .1); color: inherit; text-decoration: none; transition: padding .25s ease, color .25s ease; }
  .forge3d-docs-card > span { color: #6ec5ca; font-size: .65rem; letter-spacing: .12em; }
  .forge3d-docs-card h2 { color: #e8fbff; font-size: 1.05rem; font-weight: 600; }
  .forge3d-docs-card p { margin-top: .35rem; color: #668993; font-size: .8rem; line-height: 1.5; }
  .forge3d-docs-card > b { color: #668993; font-size: 1.2rem; font-weight: 400; transition: color .25s ease, transform .25s ease; }
  .forge3d-docs-card:hover { padding-right: .8rem; padding-left: .8rem; color: #e8fbff; }
  .forge3d-docs-card:hover > b { color: #6ec5ca; transform: translate(2px, -2px); }
  @media (max-width: 600px) { .forge3d-docs-index { padding-top: 4rem; } .forge3d-docs-list { margin-top: 4rem; } .forge3d-docs-card { grid-template-columns: 2rem 1fr auto; gap: .7rem; } }
</style>
