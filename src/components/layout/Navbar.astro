---
import SpillTabs from "../ui/SpillTabs";

const activePath = Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/$/, "");
const isForge3D = Astro.url.pathname.startsWith("/3d");
const isForge3DModels = Astro.url.pathname.startsWith("/3d/models");
const isForge3DDocs = Astro.url.pathname.startsWith("/3d/docs");
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-zinc-950/80 backdrop-blur-xl">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6">
    <a
      href={isForge3D ? "/3d" : "/"}
      class="brand-link flex items-center gap-3 text-lg font-semibold tracking-tight text-white"
      aria-label={isForge3D ? "ForgeX3D home" : "UI Forge home"}
    >
      <img
        class="brand-mark"
        src="/favicon.svg"
        width="28"
        height="28"
        alt=""
        aria-hidden="true"
      />
      <span>{isForge3D ? "ForgeX3D" : "UI Forge"}</span>
    </a>

    {isForge3D ? (
      <div class="hidden items-center gap-6 text-sm md:flex">
        <a href="/3d/models" class={`forge3d-nav-link${isForge3DModels ? " is-active" : ""}`}>Models</a>
        <a href="/3d/docs" class={`forge3d-nav-link${isForge3DDocs ? " is-active" : ""}`}>Docs</a>
        <a href="/" class="forge3d-back-link">UI Forge</a>
      </div>
    ) : (
      <SpillTabs
        client:load
        mode="navigation"
        value={activePath}
        className="hidden md:block"
        items={[
          { label: "Components", value: "/components", href: "/components" },
          { label: "Docs", value: "/docs", href: "/docs" },
          { label: "ForgeX3D", value: "/3d", href: "/3d" },
          { label: "About", value: "/about", href: "/about" },
        ]}
      />
    )}

    <a
      href="https://github.com"
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-lg border border-white/10 px-3 py-2 text-sm text-zinc-300 transition-colors hover:bg-white/5 hover:text-white"
    >
      GitHub
    </a>
  </nav>
</header>
