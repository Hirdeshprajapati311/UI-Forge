---
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-zinc-950/80 backdrop-blur-xl">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6">
    <a
      href="/"
      class="brand-link flex items-center gap-3 text-lg font-semibold tracking-tight text-white"
      aria-label="UI Forge home"
    >
      <img
        class="brand-mark"
        src="/favicon.svg"
        width="28"
        height="28"
        alt=""
        aria-hidden="true"
      />
      <span>UI Forge</span>
    </a>

    <div class="hidden items-center gap-6 text-sm text-zinc-400 md:flex">
      <a href="/components" class="transition-colors hover:text-white">
        Components
      </a>

      <a href="/docs" class="transition-colors hover:text-white">
        Docs
      </a>

      <a href="/about" class="transition-colors hover:text-white">
        About
      </a>
    </div>

    <a
      href="https://github.com"
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-lg border border-white/10 px-3 py-2 text-sm text-zinc-300 transition-colors hover:bg-white/5 hover:text-white"
    >
      GitHub
    </a>
  </nav>
</header>
